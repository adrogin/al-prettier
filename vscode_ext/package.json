{
    "name": "al-prettier-vscode",
    "displayName": "AL Prettier",
    "description": "Prettier formatter for AL language in VS Code",
    "version": "0.1.0",
    "publisher": "al-prettier",
    "icon": "vscode_ext/resources/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Formatters"
    ],
    "keywords": [
        "al",
        "prettier",
        "formatter",
        "format",
        "code"
    ],
    "activationEvents": [
        "onLanguage:al"
    ],
    "main": "./vscode_ext/dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "AL Prettier",
            "properties": {
                "alPrettier.tabWidth": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of spaces per indentation level"
                },
                "alPrettier.useTabs": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use tabs instead of spaces for indentation"
                },
                "alPrettier.printWidth": {
                    "type": "number",
                    "default": 120,
                    "description": "Specify the line length that the printer will wrap on"
                }
            }
        }
    },
    "scripts": {
        "build": "node build.js",
        "watch": "node build.js --watch",
        "pretest": "npm run build",
        "test": "node ./dist/test/runTest.js",
        "vscode:prepublish": "npm run build",
        "package": "vsce package --no-dependencies"
    },
    "dependencies": {
        "prettier": "^3.8.1",
        "antlr4": "^4.13.2"
    },
    "devDependencies": {
        "@types/vscode": "^1.75.0",
        "esbuild": "^0.19.0",
        "vsce": "^2.15.0"
    }
}