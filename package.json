{
    "name": "al-prettier-vscode",
    "displayName": "AL Prettier",
    "description": "Prettier formatter for AL language in VS Code",
    "version": "0.2.2",
    "publisher": "alexander-drogin",
    "author": {
        "name": "Alexander Drogin"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/adrogin/al-prettier.git"
    },
    "bugs": {
        "url": "https://github.com/adrogin/al-prettier/issues"
    },
    "icon": "vscode_ext/resources/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Formatters"
    ],
    "keywords": [
        "al",
        "prettier",
        "formatter",
        "code",
        "Business Central"
    ],
    "activationEvents": [
        "onLanguage:al"
    ],
    "main": "./vscode_ext/dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "AL Prettier",
            "properties": {
                "alPrettier.tabWidth": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of spaces per indentation level"
                },
                "alPrettier.useTabs": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use tabs instead of spaces for indentation"
                },
                "alPrettier.printWidth": {
                    "type": "number",
                    "default": 120,
                    "description": "Specify the line length that the printer will wrap on"
                },
                "alPrettier.groupGlobalVars": {
                    "type": "string",
                    "default": "none",
                    "description": "Enables grouping of global variables in table objects. Available options are: none, top, bottom, beforeCode"
                },
                "alPrettier.noLineBreaksInAttributes": {
                    "type": "boolean",
                    "default": false,
                    "description": "If set to true, procedure attributes are always printed in a single line, ignoring the max line width"
                },
                "alPrettier.removeEmptyElements": {
                    "type": "boolean",
                    "default": false,
                    "description": "Remove empty optional element blocks, such as fieldgroups or report labels without content, from AL objects"
                }
            }
        }
    },
    "scripts": {
        "build": "node build.js",
        "build:prod": "node build.js --production",
        "watch": "node build.js --watch",
        "pretest": "npm run build",
        "test": "NODE_OPTIONS=--experimental-vm-modules mocha",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules mocha --watch",
        "test:coverage": "c8 NODE_OPTIONS=--experimental-vm-modules mocha",
        "vscode:prepublish": "npm run build:prod",
        "package": "vsce package --no-dependencies",
        "package:prod": "npm run build:prod && vsce package --no-dependencies",
        "package:dev": "npm run build && vsce package --no-dependencies --allow-star-activation"
    },
    "dependencies": {
        "antlr4": "^4.13.2",
        "prettier": "^3.8.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.75.0",
        "c8": "^8.0.1",
        "chai": "^6.2.2",
        "esbuild": "^0.25.0",
        "mocha": "^11.7.5",
        "vsce": "^2.15.0"
    }
}